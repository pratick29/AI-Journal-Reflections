# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API Key.
# Enables interactive Maps JavaScript API, Places API (New) Autocomplete, and Advanced Markers.
# Prototyping: Obtain a free zero-billing Maps Demo Key at:
# https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_mcp_codeassist_v1_aistudio
VITE_GOOGLE_MAPS_API_KEY=""

# ADMIN_PASSPHRASE: Master passkey for reviewer and curatorial security elevation.
# Evaluators and reviewers can input this in the Admin Security Dashboard to unlock telemetry and audit trails.
ADMIN_PASSPHRASE="curator-philosopher-2026"

# ADMIN_EMAILS: Comma-separated list of Google accounts granted administrative authority.
ADMIN_EMAILS=""

# ADMIN_UIDS: Comma-separated list of Firebase UIDs granted administrative authority.
ADMIN_UIDS=""
